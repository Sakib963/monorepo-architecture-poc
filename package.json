{
  "name": "monorepo-poc",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "nx run-many --target=dev --all --parallel=10",
    "dev:user": "nx run-many --target=serve --projects=user-portal,@poc/api-gateway,@poc/user-service,@poc/notification-service --parallel=4",
    "dev:admin": "nx run-many --target=serve --projects=@poc/team-angular,@poc/api-gateway,@poc/user-service,@poc/notification-service --parallel=4",
    "dev:backend": "nx run-many --target=serve --projects=@poc/api-gateway,@poc/user-service,@poc/notification-service --parallel=3",
    "dev:user:ui": "nx serve user-portal",
    "dev:admin:ui": "nx serve @poc/team-angular",
    "dev:showcase": "nx serve @poc/showcase",
    "build": "nx run-many --target=build --all",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "graph": "nx graph"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~18.2.0",
    "@angular-devkit/core": "~18.2.0",
    "@angular-devkit/schematics": "~18.2.0",
    "@angular-eslint/eslint-plugin": "^18.3.0",
    "@angular-eslint/eslint-plugin-template": "^18.3.0",
    "@angular-eslint/template-parser": "^18.3.0",
    "@angular/cli": "~18.2.0",
    "@angular/compiler-cli": "~18.2.0",
    "@angular/language-service": "~18.2.0",
    "@nx/angular": "19.8.13",
    "@nx/eslint": "19.8.13",
    "@nx/eslint-plugin": "^19.8.13",
    "@nx/js": "19.8.13",
    "@nx/node": "19.8.13",
    "@nx/vite": "19.8.13",
    "@nx/web": "19.8.13",
    "@nx/webpack": "19.8.13",
    "@schematics/angular": "~18.2.0",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@typescript-eslint/utils": "^7.16.0",
    "eslint": "^8.57.0",
    "nx": "19.8.13",
    "prettier": "^2.6.2",
    "tslib": "^2.3.0",
    "typescript": "~5.5.0"
  },
  "dependencies": {
    "@angular/animations": "~18.2.0",
    "@angular/common": "~18.2.0",
    "@angular/compiler": "~18.2.0",
    "@angular/core": "~18.2.0",
    "@angular/forms": "~18.2.0",
    "@angular/platform-browser": "~18.2.0",
    "@angular/platform-browser-dynamic": "~18.2.0",
    "@angular/router": "~18.2.0",
    "rxjs": "~7.8.0",
    "zone.js": "~0.14.3"
  }
}
