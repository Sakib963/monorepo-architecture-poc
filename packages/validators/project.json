{
  "name": "@poc/validators",
  "root": "packages/validators",
  "sourceRoot": "packages/validators/src",
  "projectType": "library",
  "tags": ["type:package"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "outputPath": "dist/packages/validators",
        "main": "packages/validators/src/index.ts",
        "tsConfig": "packages/validators/tsconfig.json",
        "assets": []
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": { "lintFilePatterns": ["packages/validators/**/*.ts"] }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx nx build @poc/validators && node --test tests/shared/validators-schemas.test.js"
      }
    }
  }
}
